generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  decisionCases DecisionCase[]
}

model DecisionCase {
  id           String        @id @default(uuid())
  title        String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  alternatives Alternative[]
  criteria     Criterion[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Criterion {
  id             String             @id @default(uuid())
  name           String
  weight         Float
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  decisionCaseId String
  type           CriterionType      @default(benefit)
  scores         AlternativeScore[]
  decisionCase   DecisionCase       @relation(fields: [decisionCaseId], references: [id], onDelete: Cascade)

  @@index([decisionCaseId])
}

model Alternative {
  id             String             @id @default(uuid())
  name           String
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  decisionCaseId String
  decisionCase   DecisionCase       @relation(fields: [decisionCaseId], references: [id], onDelete: Cascade)
  scores         AlternativeScore[]

  @@index([decisionCaseId])
}

model AlternativeScore {
  id            String      @id @default(uuid())
  value         Float
  alternativeId String
  criterionId   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  alternative   Alternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)
  criterion     Criterion   @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([alternativeId, criterionId])
  @@index([criterionId])
  @@index([alternativeId])
}

enum CriterionType {
  benefit
  cost
}
